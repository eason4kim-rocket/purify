# Purify - Web Cleaning API for AI Agents
# Copy this file to .env and customize as needed.

# Server
PURIFY_HOST=0.0.0.0
PURIFY_PORT=8080
PURIFY_MODE=release            # debug | release | test

# Browser (Rod)
PURIFY_HEADLESS=true
PURIFY_MAX_PAGES=10            # Max concurrent browser tabs
PURIFY_NO_SANDBOX=false        # Set true in Docker
PURIFY_PROXY=                  # Default proxy: http://user:pass@host:port
PURIFY_BROWSER_BIN=            # Override Chromium binary path

# Scraper
PURIFY_DEFAULT_TIMEOUT=30s
PURIFY_MAX_TIMEOUT=120s
PURIFY_NAV_TIMEOUT=15s
PURIFY_BLOCKED_RESOURCES=Image,Stylesheet,Font,Media

# Authentication
PURIFY_AUTH_ENABLED=true
PURIFY_API_KEYS=pk_test_abc123,pk_test_def456

# Rate Limiting
# Search is registered at burst >=1; each request still atomically pays its
# weighted cost. The maximum trust request costs 59 (legacy Search max 22),
# Answer costs 17, and Watch/Facts cost 1.
PURIFY_RATE_RPS=5              # Requests per second per API key
PURIFY_RATE_BURST=59           # Covers the maximum opt-in Search request

# Logging
PURIFY_LOG_LEVEL=info          # debug | info | warn | error
PURIFY_LOG_FORMAT=json         # json | text

# Durable storage
PURIFY_DATA_DIR=./data
PURIFY_SNAPSHOT_ENABLED=true
PURIFY_SIGNING_KEY=            # Optional Ed25519 seed hex; generated on first start when empty

# Local search index (empty disables search, and with it the answer and
# watch capabilities that compose on top of it)
PURIFY_SEARCH_INDEX_PATH=
# Add pages fetched while serving a request to the index (privacy decision).
PURIFY_SEARCH_INDEX_FEED=false

# Metadata reranker (process-owned and default-off; no request BYOK fallback).
# A certified runtime remains unavailable until both authenticated deployment
# admission and a pinned recording manifest are committed. Public endpoints
# require HTTPS; private HTTP also requires the explicit private-network opt-in.
PURIFY_RERANK_ENABLED=false
PURIFY_RERANK_ENDPOINT=
PURIFY_RERANK_API_KEY=
PURIFY_RERANK_PROFILE=qwen3-reranker-0.6b-v1
PURIFY_RERANK_ALLOW_PRIVATE=false
PURIFY_RERANK_TIMEOUT_SECONDS=5

# Managed compiler (process-owned credential; never used for request BYOK)
PURIFY_COMPILER_ENABLED=false
PURIFY_COMPILER_API_KEY=
PURIFY_COMPILER_MODEL=gpt-4o-mini
PURIFY_COMPILER_BASE_URL=https://api.openai.com/v1

# Entity attribution (process-owned credential; never used for request BYOK)
PURIFY_EAV_ENABLED=false
PURIFY_EAV_REFEREE_ENABLED=true
PURIFY_EAV_CACHE_ENTRIES=128
PURIFY_EAV_LLM_API_KEY=
PURIFY_EAV_LLM_MODEL=gpt-4o-mini
PURIFY_EAV_LLM_BASE_URL=https://api.openai.com/v1
# Managed EAV endpoint only; request BYOK remains public-only.
PURIFY_EAV_LLM_ALLOW_PRIVATE=false
